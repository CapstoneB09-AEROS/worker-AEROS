# Salin file ini menjadi .env lalu isi. JANGAN di-commit (.env sudah diabaikan git).
# MQTT (HiveMQ Cloud): pengguna WORKER, bukan pengguna ESP. Perlu izin subscribe aeros/+/telemetry dan publish ke aeros/+/telemetry/ack
HIVEMQ_HOST=
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
# Harus SAMA dengan HMAC_SECRET di firmware-v2/include/secrets.h
HMAC_SECRET=
# Supabase: kunci service role HANYA di sini. Jangan di ESP, aplikasi, git, atau chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Pengaturan worker (nilai dari teman)
# (MAX_OFFLINE_AGE_DAYS, MAX_FUTURE_SKEW_SECONDS, LIVE_STALENESS_SECONDS, COMMAND_RETRY_MS, POLL_INTERVAL_MS dihapus:
#  tidak dibaca kode mana pun, dan perintah "Saya Tahu" sudah dibuang)
# Rilis (dokumentasi/keputusan/rancangan-worker-mvp.md bagian 7):
# WRITE_STATUS_COLUMN: bawaan true. Ubah ke false bersamaan dengan SQL 4b (kolom status menjadi turunan).
WRITE_STATUS_COLUMN=true
# ACCEPT_V3: bawaan true. Ubah ke false di langkah terakhir, setelah ESP versi 4 terpasang dan terbukti.
ACCEPT_V3=true
# ALLOW_DEMO_READINGS=true   # hanya bila data simulasi (demo = true) boleh disimpan
